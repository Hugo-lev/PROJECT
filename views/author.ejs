            </div>
            </div>
            </div>  

    </div>
  </div>
      <div class="right-section">

    <div class="dark-mode">
        <img class="mode-icon"src="/static/img/icon/menu-dark.svg"alt="">
    </div>

    <div class="menu">

        <a href="/" class="menu-icon">
            <span class="tooltip">project</span>
            <img src="icon/Home.svg" alt="">
        </a>

        <div class="menu-icon">
            <span class="tooltip">coding</span>
            <img src="icon/file-code.svg" alt="">
        </div>

        <div class="menu-icon">
            <span class="tooltip">degree</span>
            <img src="icon/sv.svg" alt="">
        </div>

        <div class="menu-icon">
            <span class="tooltip">work</span>
            <img src="/static/img/icon/menu-work.svg" alt="">
        </div>

        <div class="menu-icon">
