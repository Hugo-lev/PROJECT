                            </div>
                        </div>

                        <div class="lang-row">
                            <div class="lang-info">
                                <span>Js</span>
                                <span>80%</span>
                            </div>
                            <div class="progress-bg">
                                <div
                                    class="progress-fill"
                                    style="width: 80%"
                                ></div>
                            </div>
                        </div>
                        <div class="lang-row">
                            <div class="lang-info">
                                <span>PHP</span>
                                <span>75%</span>
                            </div>
                            <div class="progress-bg">
                                <div
                                    class="progress-fill"
                                    style="width: 75%"
                                ></div>
                            </div>
                        </div>

                        <div class="lang-row">
                            <div class="lang-info">
                                <span>WordPress</span>
                                <span>85%</span>
                            </div>
                            <div class="progress-bg">
                                <div
                                    class="progress-fill"
                                    style="width: 85%"
