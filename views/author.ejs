<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet"/>
    <link rel="stylesheet" href="/main.css">
    <script src="//maxcdn.bootstrapcdn.com/bootstrap/4.1.1/js/bootstrap.min.js"></script>
    <title>PORTFOLIO</title>
</head>

<body>
    <div class = "frame">
        <div class="main_frame">
           <div class="left_frame"> 
                <div class="left_1">
                    <div class="left_1-1">
                        <img src="images/profile.png" width="156px" height="142px" alt="">
                    </div>
                    <div class="left_1-2"><%=user.name%></div>
                    <div class="left_1-3"><%=user.profession%></div>
                    <div class="left-icons">
                        <a class="link_href" href="">
                            <div class="icon">
                                <img src="icon/Icons-facebook.svg" class="icon-1">
                            </div>
                        </a>

                        <a class="link_href" href="">
                            <div class="icon">
                                <img src="icon/Icons-instagram.svg" class="icon-1">
                            </div>
                        </a>

                        <a class="link_href" href="">
                            <div class="icon">
                                <img src="icon/Icons-twitter.svg" class="icon-1">
                            </div>
                        </a>

                        <a class="link_href" href="">
                            <div class="icon">
                                <img src="icon/Icons-Youtube.svg" class="icon-1">
                            </div>
                        </a>
                    </div>
                </div>
                <div class="marginer"></div>
                <div class="left_2">
                    <div class="info-row">
                        <span class="info-label">Age:</span>
                        <span class="info-value"><%=user.age%></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Residence:</span>
                        <span class="info-value"><%=user.residence%></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Freelance:</span>
                        <span class="info-value text-green">Available</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Address:</span>
                        <span class="info-value"><%=user.adress%></span>
                    </div>
                </div>
                <div class="marginer"></div>
                <div class="left_3">
                    <h3 class="section-title">Languages</h3>
                        <div class="lang-row">
                            <div class="lang-info">
                                <span>Russian</span>
                                <span>60%</span>
                            </div>
                            <div class="progress-bg">
                                <div
                                    class="progress-fill"
                                    style="width: 100%"
                                ></div>
                            </div>
                        </div>

                        <div class="lang-row">
                            <div class="lang-info">
                                <span>Korean</span>
                                <span>40%</span>
                            </div>
                            <div class="progress-bg">
                                <div
                                    class="progress-fill"
                                    style="width: 80%"
                                ></div>
                            </div>
                        </div>

                    <div class="lang-row">
                        <div class="lang-info">
                            <span>English</span>
                            <span>20%</span>
                        </div>
                            <div class="progress-bg">
                                <div
                                    class="progress-fill"
                                    style="width: 60%"
                                ></div>
                            </div>
                    </div>
                </div>    
                <div class="marginer"></div>
                <div class="left_4">
                    <h3 class="section-title">Skills</h3>
                        <div class="lang-row">
                            <div class="lang-info">
                                <span>Html</span>
                                <span>90%</span>
                            </div>
                            <div class="progress-bg">
                                <div
                                    class="progress-fill"
                                    style="width: 90%"
                                ></div>
                            </div>
                        </div>

                        <div class="lang-row">
                            <div class="lang-info">
                                <span>CSS</span>
                                <span>85%</span>
                            </div>
                            <div class="progress-bg">
                                <div
                                    class="progress-fill"
                                    style="width: 85%"
                                ></div>
                            </div>
                        </div>

                        <div class="lang-row">
                            <div class="lang-info">
                                <span>Js</span>
                                <span>80%</span>
                            </div>
                            <div class="progress-bg">
                                <div
                                    class="progress-fill"
                                    style="width: 80%"
                                ></div>
                            </div>
                        </div>
                        <div class="lang-row">
                            <div class="lang-info">
                                <span>PHP</span>
                                <span>75%</span>
                            </div>
                            <div class="progress-bg">
                                <div
                                    class="progress-fill"
                                    style="width: 75%"
                                ></div>
                            </div>
                        </div>
                        <div class="lang-row">
                            <div class="lang-info">
                                <span>WordPress</span>
                                <span>85%</span>
                            </div>
                            <div class="progress-bg">
                                <div
                                    class="progress-fill"
                                    style="width: 85%"
                                ></div>
                            </div>
                        </div>
                </div>
                <div class="marginer"></div>
                <div class="left_5">
                    <h4 class="section-title">Extra Skills</h4>

                        <ul class="extra-list">
                            <li>
                                <i class="fa fa-code"></i> Bootstrap,
                                   Materialize
                            </li>
                            <li>
                                <i class="fa fa-code"></i> Stylus, Sass, Less
                            </li>
                            <li>
                                <i class="fa fa-code"></i> Gulp, Webpack, Grunt
                            </li>
                                <li><i class="fa fa-code"></i> GIT Knowledge</li>
                            </ul>
                </div>
           </div>
            <div class="marginer"></div>
            <div class="mid_frame">
                <div class="mid-1"></div>
                <div class="marginer"></div>
                <div class="mid-2"></div>
                <div class="marginer"></div>
            </div>
            <div class="right_frame"></div>


        </div>
    </div>
    
</body>

</html>