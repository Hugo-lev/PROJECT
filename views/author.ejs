                            </div>
                        </div>

                        <div class="lang-row">
                            <div class="lang-info">
                                <span>CSS</span>
                                <span>85%</span>
                            </div>
                            <div class="progress-bg">
                                <div
                                    class="progress-fill"
                                    style="width: 85%"
